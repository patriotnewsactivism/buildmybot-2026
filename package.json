{
  "name": "buildmybot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "lint": "biome check .",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate:schema": "tsx scripts/runMigrations.ts",
    "migrate:data": "tsx scripts/runDataMigration.ts",
    "migrate:all": "npm run migrate:schema && npm run migrate:data"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.2",
    "@types/memoizee": "^0.4.12",
    "@types/multer": "^2.0.0",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.344.0",
    "memoizee": "^0.4.17",
    "multer": "^2.0.2",
    "openid-client": "^6.8.1",
    "passport": "^0.7.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "postgres": "^3.4.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "stripe": "^20.1.0",
    "stripe-replit-sync": "^1.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.3",
    "uuid": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^16.4.5",
    "typescript": "^5.4.2",
    "vite": "^5.1.5"
  }
}
